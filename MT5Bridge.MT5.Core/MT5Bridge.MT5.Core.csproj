<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- NuGet Package Configuration -->
  <PropertyGroup>
    <PackageId>MT5Bridge.MT5.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Kun</Authors>
    <Company>xSyphon</Company>
    <Product>MT5Bridge</Product>
    <Description>MT5 Manager API wrapper for .NET</Description>
    <PackageTags>mt5;metatrader5;trading;manager-api</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- MT5 SDK References -->
  <ItemGroup>
    <Reference Include="MetaQuotes.MT5CommonAPI64">
      <HintPath>..\libs\MetaQuotes.MT5CommonAPI64.dll</HintPath>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="MetaQuotes.MT5ManagerAPI64">
      <HintPath>..\libs\MetaQuotes.MT5ManagerAPI64.dll</HintPath>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Native DLL Files - Copy to output -->
  <ItemGroup>
    <None Include="..\libs\MT5APIManager64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MT5APIManager64.dll</Link>
    </None>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\MT5Bridge.Core\MT5Bridge.Core.csproj" />
  </ItemGroup>

</Project>

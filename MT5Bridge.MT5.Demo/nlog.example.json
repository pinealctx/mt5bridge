{
    "NLog": {
        "throwConfigExceptions": true,
        "targets": {
            "console": {
                "type": "Console",
                "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
            },
            "file": {
                "type": "File",
                "fileName": "logs/mt5test-${shortdate}.log",
                "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}",
                "archiveAboveSize": 10485760,
                "maxArchiveFiles": 10
            }
        },
        "rules": [
            {
                "logger": "*",
                "minLevel": "Debug",
                "writeTo": "console"
            },
            {
                "logger": "*",
                "minLevel": "Debug",
                "writeTo": "file"
            }
        ]
    }
}